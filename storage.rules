rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidImageSize() {
      // Max 5MB
      return request.resource.size < 5 * 1024 * 1024;
    }

    // User profile images
    match /users/{userId}/profile.jpg {
      // Anyone authenticated can read profile images
      allow read: if isAuthenticated();

      // Only the owner can upload/update their profile image
      allow write: if isAuthenticated()
                   && isOwner(userId)
                   && isValidImageType()
                   && isValidImageSize();

      // Only the owner can delete their profile image
      allow delete: if isAuthenticated()
                    && isOwner(userId);
    }

    // Event images
    match /events/{userId}/{imageFile} {
      // Anyone authenticated can read event images
      allow read: if isAuthenticated();

      // Only authenticated productoras can upload event images to their folder
      allow write: if isAuthenticated()
                   && isOwner(userId)
                   && isValidImageType()
                   && isValidImageSize();

      // Only the owner can delete event images
      allow delete: if isAuthenticated()
                    && isOwner(userId);
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
